# ReqWiseAI environment. Copy to .env.local and fill in. NEVER commit .env.local.
# Only explicitly NEXT_PUBLIC_ values are browser-safe; all other values stay server-only.

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — must never be NEXT_PUBLIC_) ---
# Since Slice 4, the analysis run path does NOT use this key — persist_analysis_result()
# is a SECURITY DEFINER RPC called on the user's own client. Kept for seeding
# (scripts/generate-profile-seed.mts) and the runtime verification scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server only) ---
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=

# --- Own-Gemini-key encryption (server only, Phase 1 Slice 3) ---
# 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts each user's own saved Gemini API key (AES-256-GCM) at rest in
# user_gemini_keys. Missing entirely = the "save your own key" feature is simply
# unavailable (fails loudly only where it's actually used, never on every page load).
# Present but not exactly 32 bytes once decoded = a real misconfiguration and
# readServerEnvironment() throws immediately.
GEMINI_KEY_ENCRYPTION_SECRET=

# --- Admin (server only, Phase 1 Slice 4) ---
# The one admin account's email. No admin role exists in the database — every
# admin-only page load and Server Action compares this against
# supabase.auth.getUser().email in Node (lib/admin/guard.ts), never a client flag.
# Missing entirely = /admin is closed to everyone, not open to everyone — the opposite
# failure posture from GEMINI_KEY_ENCRYPTION_SECRET above.
ADMIN_EMAIL=

# --- Application runtime ---
APPLICATION_URL=http://localhost:3000
