# ReqWiseAI environment. Copy to .env.local and fill in. NEVER commit .env.local.
# Phase 3A introduces these; no application code reads them yet (that is Phase 3B).

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — must never be NEXT_PUBLIC_) ---
# Since Slice 4, the analysis run path does NOT use this key — persist_analysis_result()
# is a SECURITY DEFINER RPC called on the user's own client. Kept for seeding
# (scripts/generate-profile-seed.mts) and the runtime verification scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# mock (default, deterministic, no network) | gemini (Phase 3B+)
AI_PROVIDER=mock
# server only; required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
